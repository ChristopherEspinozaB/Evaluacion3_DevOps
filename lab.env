export AWS_PAGER=""
if [[ "$(uname -s)" == MINGW* || "$(uname -s)" == MSYS* ]]; then
  export MSYS_NO_PATHCONV=1
  aws() { command aws "$@" | tr -d '\r'; return "${PIPESTATUS[0]}"; }
fi

[ -f lab.env ] && source lab.env

# Si tu correo ya estaba en lab.env se mantiene; si no, reemplázalo aquí:
export EMAIL="${EMAIL:-chr.espinozab@duocuc.cl}"
export AWS_REGION=us-east-1
export CLUSTER=supletanes-ecs
export NAMESPACE=supletanes.local
export ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)

if [ -z "$ACCOUNT_ID" ] || [ "$ACCOUNT_ID" = "None" ]; then
  echo "ERROR: Credenciales de AWS Academy vencidas o no configuradas. Repite el Paso 0.2."
  return 1 2>/dev/null || exit 1
fi

export LAB_ROLE_ARN=arn:aws:iam::${ACCOUNT_ID}:role/LabRole

# 1. Usar el repositorio ECR ya existente (o crearlo si falta)
aws ecr create-repository --repository-name supletanes-app >/dev/null 2>&1 || true
export ECR_URI=${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/supletanes-app

# 2. Recuperar VPC, Subnets y el ID del Security Group ya creado (supletanes-ecs-sg)
export VPC_ID=$(aws ec2 describe-vpcs --filters Name=isDefault,Values=true --query "Vpcs[0].VpcId" --output text)
export SUBNET1=$(aws ec2 describe-subnets --filters Name=vpc-id,Values=$VPC_ID --query "Subnets[0].SubnetId" --output text)
export SUBNET2=$(aws ec2 describe-subnets --filters Name=vpc-id,Values=$VPC_ID --query "Subnets[1].SubnetId" --output text)
export SG_ID=$(aws ec2 describe-security-groups --filters Name=group-name,Values=supletanes-ecs-sg Name=vpc-id,Values=$VPC_ID --query "SecurityGroups[0].GroupId" --output text)

if [ -z "$SG_ID" ] || [ "$SG_ID" = "None" ]; then
  export SG_ID=$(aws ec2 create-security-group --group-name supletanes-ecs-sg --description "SG cumplimiento supletanes ECS" --vpc-id $VPC_ID --query GroupId --output text)
fi

aws ec2 authorize-security-group-ingress --group-id $SG_ID --protocol tcp --port 8080 --cidr 0.0.0.0/0 >/dev/null 2>&1 || true
aws ec2 authorize-security-group-ingress --group-id $SG_ID --protocol tcp --port 3306 --source-group $SG_ID >/dev/null 2>&1 || true

# 3. Crear clúster ECS, namespace de Service Connect y grupo de logs
aws ecs create-cluster --cluster-name $CLUSTER --settings name=containerInsights,value=enabled >/dev/null 2>&1 || true
aws ecs update-cluster --cluster $CLUSTER --service-connect-defaults namespace=$NAMESPACE >/dev/null
export NS_ID=$(aws ecs describe-clusters --clusters $CLUSTER --query "clusters[0].serviceConnectDefaults.namespace" --output text | awk -F/ '{print $NF}')
aws logs create-log-group --log-group-name /ecs/supletanes >/dev/null 2>&1 || true

# 4. Crear tema SNS, suscripción de correo y alarma CloudWatch
export TOPIC_ARN=$(aws sns create-topic --name supletanes-alertas --query TopicArn --output text)

if [[ "$EMAIL" == *"TU_CORREO"* ]] || [[ "$EMAIL" == *"ejemplo.com"* ]]; then
  echo "AVISO: No se suscribió correo porque EMAIL tiene texto de ejemplo. Ejecuta: export EMAIL=\"tu@correo.com\" y luego: aws sns subscribe --topic-arn $TOPIC_ARN --protocol email --notification-endpoint \$EMAIL"
else
  aws sns subscribe --topic-arn $TOPIC_ARN --protocol email --notification-endpoint "$EMAIL" >/dev/null
fi

aws cloudwatch put-metric-alarm \
  --alarm-name "Supletanes-5XX-Critico" \
  --namespace AWS/ECS --metric-name HTTPCode_Target_5XX_Count \
  --dimensions Name=TargetDiscoveryName,Value=supletanes-app \
  --statistic Sum --period 60 --evaluation-periods 1 \
  --threshold 5 --comparison-operator GreaterThanOrEqualToThreshold \
  --treat-missing-data notBreaching \
  --alarm-actions $TOPIC_ARN

# 5. Guardar todas las variables en lab.env y mostrar resultados
guardar() {
  env | grep -E '^(ACCOUNT_ID|LAB_ROLE_ARN|AWS_REGION|CLUSTER|NAMESPACE|EMAIL|ECR_URI|VPC_ID|SUBNET1|SUBNET2|SG_ID|NS_ID|TOPIC_ARN|APP_IP|DB_IP)=' \
    | sed 's/^/export /' > lab.env
}
guardar

printf "\n=== ARCHIVO lab.env GUARDADO ===\n"
cat lab.env
printf "\n=== VALORES PARA GITHUB SECRETS ===\nAWS_ACCOUNT_ID=%s\nAWS_SUBNET1=%s\nAWS_SUBNET2=%s\nAWS_SG_ID=%s\n" "$ACCOUNT_ID" "$SUBNET1" "$SUBNET2" "$SG_ID"