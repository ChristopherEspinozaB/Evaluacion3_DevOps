{
  "family": "supletanes-mysql",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "${LAB_ROLE_ARN}",
  "taskRoleArn": "${LAB_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "mysql",
      "image": "mysql:8.0",
      "essential": true,
      "portMappings": [
        { "name": "mysql-port", "containerPort": 3306, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "MYSQL_ROOT_PASSWORD", "value": "rootpass" },
        { "name": "MYSQL_DATABASE", "value": "supletanes_db" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "mysqladmin ping -h localhost -uroot -prootpass || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/supletanes",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "mysql"
        }
      }
    }
  ]
}