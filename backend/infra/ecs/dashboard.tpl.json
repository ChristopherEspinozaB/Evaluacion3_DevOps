{
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Uso de Recursos: CPU y Memoria",
        "region": "${AWS_REGION}",
        "stat": "Average",
        "period": 60,
        "metrics": [
          ["AWS/ECS", "CPUUtilized", "ServiceName", "supletanes-app", "ClusterName", "${CLUSTER}"],
          ["AWS/ECS", "MemoryUtilized", "ServiceName", "supletanes-app", "ClusterName", "${CLUSTER}"]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Tráfico Mesh: Requests y Errores 5XX",
        "region": "${AWS_REGION}",
        "stat": "Sum",
        "period": 60,
        "metrics": [
          ["AWS/ECS", "RequestCount", "DiscoveryName", "supletanes-app", "ServiceName", "supletanes-app", "ClusterName", "${CLUSTER}"],
          ["AWS/ECS", "HTTPCode_Target_5XX_Count", "TargetDiscoveryName", "supletanes-app"]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "CI/CD: Tiempo de Despliegue (segundos)",
        "region": "${AWS_REGION}",
        "stat": "Maximum",
        "period": 300,
        "metrics": [
          ["Supletanes/CICD", "DeploymentDurationSeconds", "Service", "supletanes-app"]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "CI/CD: Cobertura de Pruebas JaCoCo (%)",
        "region": "${AWS_REGION}",
        "stat": "Maximum",
        "period": 300,
        "metrics": [
          ["Supletanes/CICD", "TestCoveragePercent", "Service", "supletanes-app"]
        ]
      }
    }
  ]
}