{
  "cluster": "${CLUSTER}",
  "serviceName": "mysql",
  "taskDefinition": "supletanes-mysql",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["${SUBNET1}", "${SUBNET2}"],
      "securityGroups": ["${SG_ID}"],
      "assignPublicIp": "ENABLED"
    }
  },
  "serviceConnectConfiguration": {
    "enabled": true,
    "namespace": "${NAMESPACE}",
    "services": [
      {
        "portName": "mysql-port",
        "discoveryName": "mysql",
        "clientAliases": [{ "port": 3306, "dnsName": "mysql" }]
      }
    ]
  }
}